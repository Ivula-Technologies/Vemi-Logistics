# Vemi Logistics settings. Put these in cPanel > Setup Node.js App > Environment variables.
# NEXT_PUBLIC_* values are also baked into the build (GitHub repository variables), so set them in both places.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only, never in GitHub or chat

# The public address of the app, no trailing slash
NEXT_PUBLIC_SITE_URL=https://vemi.ivulatechnologies.com

# Daily job (cPanel cron sends it as a Bearer token). Any long random string.
CRON_SECRET=

# Email (Resend): a verified sending domain
RESEND_API_KEY=
VEMI_FROM_EMAIL=Vemi Logistics <trips@vemi.ivulatechnologies.com>
VEMI_OPS_EMAIL=ops@ivulatechnologies.com     # new carriers, disputes and bank transfers go here

# M-Pesa Daraja (STK push). Leave MPESA_ENV=sandbox until Safaricom approves Go Live.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=                              # Paybill number, or the Till's store number
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline  # CustomerBuyGoodsOnline for a Till
MPESA_PARTY_B=                                # only for a Till: the till number
MPESA_CALLBACK_SECRET=                        # any long random string

# Bank transfer details shown to shippers (use \n for new lines)
VEMI_BANK_DETAILS="Bank: ...\nAccount name: Ivula Technologies\nAccount number: ...\nBranch: ..."

# Optional: SMS through Africa's Talking (driver links, payment and delivery alerts)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Ops alerts by SMS (SOS, trucks gone quiet): the duty phone, 2547XXXXXXXX
VEMI_OPS_PHONE=

# Shown on the Help page
NEXT_PUBLIC_SUPPORT_WHATSAPP=                 # 2547XXXXXXXX
NEXT_PUBLIC_SUPPORT_EMAIL=

# Printed on receipts and invoices
VEMI_LEGAL_NAME=Ivula Technologies (Vemi Logistics)
VEMI_KRA_PIN=
VEMI_ADDRESS=

# Sign in with a phone number (needs Africa's Talking SMS above). Any long random string.
LOGIN_CODE_SECRET=

# Sign in with Google: set to "on" after switching Google on in Supabase (Authentication > Providers)
NEXT_PUBLIC_GOOGLE_SIGNIN=

# Push notifications on the installed phone app: run `npx web-push generate-vapid-keys` once
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@ivulatechnologies.com

# Calls through Vemi (numbers stay private): an Africa's Talking voice number
AT_VOICE_NUMBER=                              # +2547XXXXXXXX
AT_VOICE_CALLBACK_SECRET=                     # any long random string

# Card payments through PayPal (cross-border and diaspora shippers). PAYPAL_ENV=live when approved.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# One-tap M-Pesa payouts to carriers and wallet cash-outs (B2C). Until Safaricom approves, ops use the bulk CSV.
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_CONSUMER_KEY=                       # leave empty to use MPESA_CONSUMER_KEY
MPESA_B2C_CONSUMER_SECRET=
